# Copy to .env and fill in. .env is git-ignored; on Hugging Face these go in Space secrets.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# LLM providers (fill the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# which provider/model answers questions, and which one is compared against it
LLM_PRIMARY=
LLM_SECONDARY=
# optional: protects upload/delete on the public demo
ADMIN_TOKEN=
# optional: Langfuse tracing (traces every investigation; leave empty to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=production

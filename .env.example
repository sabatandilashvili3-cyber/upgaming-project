# Copy to .env and fill in. .env is git-ignored; on the server these live in /etc/engine.env (mode 600).

# Postgres with the pgvector extension. Locally: python -c "from engine.store.bulk import local_url; print(local_url())"
DATABASE_URL=postgresql://user:password@localhost:5432/engine

# Claude, the model that runs the investigations
ANTHROPIC_API_KEY=
# low | medium | high: medium is live (same accuracy as high, 19% faster; EVALUATION.md §6b)
LLM_EFFORT=medium

# protects upload and delete on a public deployment (empty = open, fine locally)
ADMIN_TOKEN=
# cost guards for a public deployment
RATE_PER_HOUR=20
DAILY_BUDGET_USD=5

# optional: Langfuse tracing of every investigation (leave empty to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=production

# tests only: a throwaway Postgres + pgvector for the database tests (CI sets this)
TEST_DATABASE_URL=
